config {
  type: "incremental",
  schema: "golden_iveco",
  name: "gld_fault",
  tags: ["daily"]
}

pre_operations {
    DELETE FROM ${self()}
    WHERE vin  IN (SELECT DISTINCT vin  FROM ${ref('stg_fault')})
    AND  fdt IN (SELECT DISTINCT  fdt FROM ${ref('stg_fault')})
}


SELECT
        vin,
        description_,
        oc,
        spn,
        fmi,
        fdt,
        fnt,
        engineSpeed,
        engineTorque,
        engineFuelTemperature,
        odometer,
        vehicleSpeed,
        geoCoordinateAltitude  ,
        geoCoordinatePositionDateTime,
        geoCoordinateLongitude,
        geoCoordinateLatitude,
        requestServerDateTime

FROM ${ref('stg_fault')}