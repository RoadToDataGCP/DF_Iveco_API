config {
  type: "table",
  schema: "presentation_iveco",
  name: "pst_odometer",
  tags: ["daily"]
}

SELECT
  vin,
  odometerEnd / 1000.0 AS odometer_km,
  tripEndDateTime AS date_
FROM (
  SELECT
    vin,
    odometerEnd,
    tripEndDateTime,
    ROW_NUMBER() OVER (PARTITION BY vin ORDER BY odometerEnd DESC) AS row_num
    FROM ${ref('gld_summary')}
  WHERE
    odometerEnd IS NOT NULL AND odometerEnd != -1
)

WHERE row_num = 1