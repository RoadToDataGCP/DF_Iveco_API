config {
  type: "table",
  schema: "staging_iveco",
  name: "stg_summary",
  tags: ["daily"]
}
SELECT
        vin,
        tripStartDateTime,
        tripEndDateTime,
        odometerStart,
        odometerEnd,
        tripId,
        driverId, 
        degreeOfDifficulty,
        degreeOfDifficultyMissionSeverity,
        degreeOfDifficultySpeedProfile,
        degreeOfDifficultyAltimetry,
        degreeOfDifficultyTwisting,
        degreeOfDifficultyAtmosphericConditions,
        degreeOfDifficultyVehicleLoad,
        vehicleCare,
        vehicleCareTireProtection,
        vehicleCareAuxiliaryBrake,
        requestServerDateTime,
        safety AS safety_,
        geoCoordinate.latitude as geoCoordinateLatitude,
        geoCoordinate.longitude as geoCoordinateLongitude,
        geoCoordinate.altitude as geoCoordinateAltitude,
        geoCoordinate.positionDateTime as geoCoordinatePositionDateTime,

        dseSummaryDieselNP.fuelSaving as dseSummaryDieselNPFuelSaving ,
        dseSummaryDieselNP.fuelSavingDeceleration as dseSummaryDieselNPFuelSavingDeceleration ,
        dseSummaryDieselNP.fuelSavingAcceleration as dseSummaryDieselNPFuelSavingAcceleration,
        dseSummaryDieselNP.fuelSavingInertia as dseSummaryDieselNPFuelSavingInertia,
        dseSummaryDieselNP.fuelSavingStopApproach as dseSummaryDieselNPFuelSavingStopApproach,
        dseSummaryDieselNP.fuelSavingEngineUse as dseSummaryDieselNPFuelSavingEngineUse,
        dseSummaryDieselNP.fuelConsumption as dseSummaryDieselNPFuelConsumption,
        dseSummaryDieselNP.fuelLevelStart as dseSummaryDieselNPFuelLevelStart,
        dseSummaryDieselNP.fuelLevelEnd as dseSummaryDieselNPFuelLevelEnd,
        dseSummaryDieselNP.totalFuelStart as dseSummaryDieselNPTotalFuelStart,
        dseSummaryDieselNP.totalFuelEnd as dseSummaryDieselNPTotalFuelEnd,

        dseSummaryElectric.scoreEnergy as dseSummaryElectric_scoreEnergy ,
        dseSummaryElectric.hiPowerBenefit as dseSummaryElectric_hiPowerBenefit ,
        dseSummaryElectric.energyManagementBenefit as dseSummaryElectric_energyManagementBenefit,
        dseSummaryElectric.energyAcceleration as dseSummaryElectric_energyAcceleration,
        dseSummaryElectric.energyRegeneration as dseSummaryElectric_energyRegeneration,
        dseSummaryElectric.energyStopApproach as dseSummaryElectric_energyStopApproach,
        dseSummaryElectric.energyManagement as dseSummaryElectric_energyManagement,
        dseSummaryElectric.deceleration as dseSummaryElectric_deceleration,
        dseSummaryElectric.tractionSwitch as dseSummaryElectric_tractionSwitch,
        dseSummaryElectric.airConditioning as dseSummaryElectric_airConditioning,
        dseSummaryElectric.accelerationStyleBenefit as dseSummaryElectric_accelerationStyleBenefit,
        dseSummaryElectric.decelerationStyleBenefit as dseSummaryElectric_decelerationStyleBenefit,
        dseSummaryElectric.regenerationBenefit as dseSummaryElectric_regenerationBenefit,
        dseSummaryElectric.stopApproachBenefit as dseSummaryElectric_stopApproachBenefit,
        dseSummaryElectric.tractionBenefit as dseSummaryElectric_tractionBenefit,
        dseSummaryElectric.regeneration as dseSummaryElectric_regeneration,
        dseSummaryElectric.stopApproach  as dseSummaryElectric_stopApproach

FROM ${ref('raw_summary')}